# Composer (backend/) — regenerated by the buildpack from composer.lock during deploy
backend/vendor/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Google Analytics service account credential — never commit real keys
backend/config/ga-service-account.json
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend (PHP) — don't commit uploaded user images or local Firebase/FCM secrets
backend/uploads/**/*.jpg
backend/uploads/**/*.jpeg
backend/uploads/**/*.png
backend/uploads/**/*.webp
!backend/uploads/**/.gitkeep

# Structured error log (see backend/lib/error_logging.php) — can contain
# request context, never committed; the directory itself stays tracked.
backend/logs/*.log
!backend/logs/.gitkeep

# Health-check cron script's real Slack webhook URL + run state — never committed.
scripts/health_alert/config.php
scripts/health_alert/.last_status

# Never commit Firebase service-account keys or other credential files.
# google-services.json / GoogleService-Info.plist are client app config
# (not secrets, per Firebase's own docs) and are intentionally tracked.
*firebase-adminsdk*.json
firebaseConfig
firebase_options.dart
