# Force browsers to always revalidate CSS/JS with the server (cheap 304 checks
# via ETag/Last-Modified) instead of relying on heuristic caching, which was
# causing deployed changes to not show up until a hard refresh/incognito.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
